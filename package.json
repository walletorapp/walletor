{
  "name": "walletor-rebuild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "docs:dev": "npm --prefix apps/docs run dev",
    "docs:build": "npm --prefix apps/docs run build",
    "docs:check": "npm --prefix apps/docs run check",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types --strict-vars=false",
    "launch:safety": "node scripts/check-launch-safety.mjs",
    "launch:check": "npm run cf-typegen && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run docs:check && npm run docs:build && npm run launch:safety && npm run test:e2e",
    "solana:format:check": "cargo fmt --manifest-path solana/Cargo.toml --all -- --check",
    "solana:test": "cargo test --manifest-path solana/Cargo.toml --workspace",
    "randomness:build": "cargo-build-sbf --tools-version v1.52 --manifest-path solana-randomness/Cargo.toml",
    "randomness:test": "npm run randomness:build && cargo-build-sbf --tools-version v1.52 --manifest-path solana-randomness/test-oracle/Cargo.toml && cargo test --manifest-path solana-randomness/Cargo.toml --locked"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@jup-ag/referral-sdk": "^0.3.0",
    "@metamask/connect-solana": "^2.1.1",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@segmento/core": "0.12.4",
    "@solana/spl-token": "^0.3.8",
    "@solana/wallet-adapter-backpack": "^0.1.14",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-trust": "^0.1.17",
    "@solana/wallet-adapter-walletconnect": "^0.1.22",
    "@solana/web3.js": "^1.98.4",
    "@switchboard-xyz/on-demand": "^3.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "hono": "^4.13.1",
    "jose": "^6.2.10",
    "lucide-react": "^1.25.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "saxes": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.19.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "ws@>=8.0.0 <9.0.0": "^8.22.0",
    "uuid": "^11.1.1"
  }
}
