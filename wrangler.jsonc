{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "walletor-public-demo",
  "main": "worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "ZEALY_API_KEY",
      "QUESTLINE_API_KEY",
      "JUPITER_API_KEY",
      "HELIUS_API_KEY",
      "BIRDEYE_API_KEY",
      "TOKEN_INGEST_SECRET",
      "REFERRAL_ADMIN_SECRET",
      "CLOUDFLARE_ACCESS_TEAM_DOMAIN",
      "CLOUDFLARE_ACCESS_AUD",
      "ADMIN_ALLOWED_EMAILS",
      "SOLANA_CLAIM_RPC_URL_PRIVATE",
      "SOLANA_CLAIM_AUTOMATION_SECRET",
    ],
  },
  "vars": {
    "WALLETOR_OWNER_ONLY": "false",
    "WALLETOR_OWNER_EMAIL": "owner@example.com",
    "ZEALY_COMMUNITY_SUBDOMAIN": "walletor-6650",
    "ZEALY_CAMPAIGN_START_AT": "2026-09-30T20:20:00.000Z",
    "QUESTLINE_ENABLED": "false",
    "QUESTLINE_QUEST_ID": "89",
    "QUESTLINE_CAMPAIGN_START_AT": "2026-10-20T12:28:30.000Z",
    "SANCTIONS_SCREENING_ENABLED": "false",
    "WALLETOR_ACCOUNTING_EPOCH": "public-launch-v1",
    "WALLETOR_PUBLIC_LAUNCH_AT": "2026-09-06T00:00:00.000Z",
    "ACCOUNTING_ENABLED": "false",
    "PAYOUTS_ENABLED": "false",
    "USDC_DISTRIBUTION_FUNDING_ENABLED": "false",
    "AUTOMATIC_CLAIM_SETTLEMENT_ENABLED": "false",
    "SOLANA_CLAIM_NETWORK": "mainnet",
    "SOLANA_CLAIM_PROGRAM_ID": "REWArDioXgQJ2fZKkfu9LCLjQfRwYWVVfsvcsR5hoXi",
    "SOLANA_CLAIM_AUTHORITY_ADDRESS": "",
    "SOLANA_SWITCHBOARD_PROGRAM_ID": "SBondMDrcV3K4kxZR1HNVT7osZxAHVHgYXL5Ze1oMUv",
    "SOLANA_SWITCHBOARD_QUEUE_ADDRESS": "A43DyUGA7s8eXPxqEjJY6EBu1KKbNgfxF8h17VAHn13w",
    "MAGICBLOCK_ENABLED": "false",
    "MAGICBLOCK_FIRST_ROUND_AT": "2026-09-22T00:00:00.000Z",
    "SOLANA_CLAIM_RPC_URL": "https://api.mainnet-beta.solana.com",
    "PRIZE_POOL_WINNER_COUNT": "22",
    "PRIZE_POOL_CLAIM_FEE_BPS": "250",
    "JUPITER_REFERRAL_FEE_ENABLED": "false",
    "JUPITER_REFERRAL_ACCOUNT": "",
    "JUPITER_REFERRAL_FEE_BPS": "50",
    "JUPITER_PARTNER_SHARE_BPS": "8000",
    "STANDARD_SWAP_FEE_USD": "1.00",
    "ADVANCED_TRADE_FEE_USD": "0.10",
    "PRIZE_POOL_PERCENTAGE": "100",
    "PLATFORM_REVENUE_PERCENTAGE": "0",
    "ROUND_DURATION_HOURS": "24",
    "WALLET_SWAP_LIMIT_ENABLED": "true",
    "WALLET_SWAP_ROLLING_LIMIT_USD": "5000.00",
    "ENABLE_STOCKS": "true",
    "ENABLE_RWA_TRADING": "false",
    "ENABLE_RWA_REWARDS": "false",
    "ENABLE_JUPITERZ_ROUTE_BADGE": "false",
    "MINIMUM_REWARD_ELIGIBLE_SWAP_USD": "5.00",
    "NEW_WALLET_REVIEW_DAYS": "7",
    "WLT_BASE_POINTS_PER_ELIGIBLE_SWAP": "2",
    "RECONCILIATION_PAUSE_THRESHOLD_USD": "0.00",
    "WALLETOR_TREASURY_ADDRESS": "",
    "WALLETOR_FEE_ASSET_MINT": "",
    "WALLETOR_STANDARD_SWAP_FEE_ATOMIC": "",
  },
  "ai": { "binding": "SUPPORT_AI" },
  "ratelimits": [
    {
      "name": "INFLUENCER_RATE_LIMIT",
      "namespace_id": "1300000001",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "ZEALY_RATE_LIMIT",
      "namespace_id": "1300000002",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "SUPPORT_RATE_LIMIT",
      "namespace_id": "1300000003",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "SUPPORT_GLOBAL_LIMIT",
      "namespace_id": "1300000004",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "walletor-public-demo-accounting",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
    {
      "binding": "TOKEN_DB",
      "database_name": "walletor-public-demo-token-index",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "token-migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PRIZE_POOL_COORDINATOR",
        "class_name": "PrizePoolCoordinator",
      },
      {
        "name": "WALLET_SWAP_RISK_GATE",
        "class_name": "WalletSwapRiskGate",
      },
      {
        "name": "LAUNCH_FEED",
        "class_name": "LaunchFeed",
      },
    ],
  },
  "workflows": [
    {
      "name": "walletor-public-demo-prize-draw",
      "binding": "PRIZE_DRAW_WORKFLOW",
      "class_name": "PrizeDrawWorkflow",
    },
    {
      "name": "walletor-public-demo-claim-settlement",
      "binding": "AUTOMATIC_CLAIM_WORKFLOW",
      "class_name": "AutomaticClaimSettlementWorkflow",
    },
  ],
  "exports": {
    "WalletorBackupReader": { "type": "worker" },
    "PrizePoolCoordinator": {
      "type": "durable-object",
      "state": "created",
      "storage": "sqlite",
    },
    "WalletSwapRiskGate": {
      "type": "durable-object",
      "state": "created",
      "storage": "sqlite",
    },
    "LaunchFeed": {
      "type": "durable-object",
      "state": "created",
      "storage": "sqlite",
    },
  },
  "triggers": {
    "crons": [],
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
